# Required for document embeddings and answer generation
GOOGLE_API_KEY=
COHERE_API_KEY=

# Optional context sufficiency check through TypeSafe Jev
# Add your key only to the local .env file and explicitly enable Jev.
TYPESAFE_API_KEY=
JEV_ENABLED=false
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.7
JEV_TIMEOUT_SECONDS=10
